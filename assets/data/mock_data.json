  "modulDetails": {
    "m1": {
      "id": "m1",
      "title": "Anggota Tubuh Manusia",
      "level": "SMA",
      "subject": "IPA",
      "totalQuestions": 30,
      "discussionCount": 1,
      "materi": [
        {
          "id": "bag1",
          "heading": "Bagian 1 : Kenapa ada Organ Tubuh?",
          "body": "Tubuh manusia tersusun atas berbagai organ yang saling bekerja sama membentuk sistem organ. Setiap organ memiliki struktur khusus untuk menjalankan fungsi spesifik seperti respirasi, pencernaan, dan sirkulasi darah demi menjaga homeostasis tubuh.",
          "imageAsset": "assets/MateriImage/Materi1.png"
        },
        {
          "id": "bag2",
          "heading": "Bagian 2 : Koordinasi Sistem Organ",
          "body": "Sistem saraf dan endokrin mengoordinasikan respon organ terhadap perubahan lingkungan internal maupun eksternal. Keterpaduan kerja organ sangat krusial bagi kelangsungan hidup manusia.",
          "imageAsset": "assets/MateriImage/Materi2.png"
        }
      ],
      "groupQuestion": {
        "title": "Apa yang membuat manusia memerlukan organ?",
        "instructions": [
          "Diskusikan pertanyaan di atas bersama seluruh anggota kelompok.",
          "Tuliskan minimal 2–3 alasan mendasar beserta contoh fungsi organ tubuh yang mendukung kelangsungan hidup manusia.",
          "Rangkum hasil diskusi dalam bentuk poin-poin ringkas pada lembar jawaban dan presentasikan."
        ],
        "indicators": [
          "Peserta didik mampu menjelaskan hubungan antara fungsi organ dengan kelangsungan hidup manusia secara tepat.",
          "Argumen yang disampaikan runtut, logis, dan didukung dengan contoh organ yang relevan.",
          "Seluruh anggota kelompok berpartisipasi aktif dalam proses diskusi dan penyusunan jawaban."
        ]
      },
      "quiz": [
        {
          "id": "q1",
          "number": 1,
          "totalQuestions": 30,
          "question": "Apa fungsi utama dari sistem muskuloskeletal (rangka dan otot) pada tubuh manusia?",
          "options": [
            "Menopang struktur tubuh dan memfasilitasi pergerakan aktif",
            "Memompa darah dan mengedarkan oksigen ke seluruh sel tubuh",
            "Mengatur produksi hormon serta metabolisme tubuh",
            "Menyaring racun dan zat sisa hasil metabolisme dari darah"
          ],
          "correctIndex": 0
        },
        {
          "id": "q2",
          "number": 2,
          "totalQuestions": 30,
          "question": "Organ tubuh yang berfungsi sebagai pusat kendali utama sistem saraf dan mengoordinasikan seluruh aktivitas tubuh adalah...",
          "options": [
            "Jantung",
            "Otak",
            "Paru-paru",
            "Sumsum tulang belakang"
          ],
          "correctIndex": 1
        },
        {
          "id": "q3",
          "number": 3,
          "totalQuestions": 30,
          "question": "Organ pernapasan utama manusia tempat terjadinya pertukaran gas oksigen (O2) dan karbon dioksida (CO2) adalah...",
          "options": [
            "Trakea",
            "Bronkus",
            "Paru-paru (Alveolus)",
            "Laring"
          ],
          "correctIndex": 2
        },
        {
          "id": "q4",
          "number": 4,
          "totalQuestions": 30,
          "question": "Bagian jantung yang memompa darah beroksigen ke seluruh jaringan tubuh melalui peredaran darah besar adalah...",
          "options": [
            "Ventrikel Kiri (Bilik Kiri)",
            "Atrium Kanan (Serambi Kanan)",
            "Ventrikel Kanan (Bilik Kanan)",
            "Atrium Kiri (Serambi Kiri)"
          ],
          "correctIndex": 0
        },
        {
          "id": "q5",
          "number": 5,
          "totalQuestions": 30,
          "question": "Organ yang memproduksi enzim pencernaan serta menghasilkan hormon insulin untuk mengatur kadar gula darah adalah...",
          "options": [
            "Lambung",
